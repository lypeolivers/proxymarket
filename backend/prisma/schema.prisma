// ProxyMarket — schema inicial (admin único).
// Próximos passos: adicionar modelos de domínio (Proxy, Sale, Customer, etc.)
// conforme as features forem detalhadas no planejamento.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  active
  inactive
  blocked
  pending
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String?
  status        Status    @default(active)
  refresh_token String?
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  is_deleted    Boolean   @default(false)

  @@index([id])
  @@index([email])
  @@map("user")
}

enum Tcg {
  one_piece
  magic
  pokemon
}

enum CardColor {
  blue
  yellow
  green
  black
  red
  purple
}

enum CardType {
  // One Piece
  leader
  don
  // Magic
  token
  commander
  // Pokémon
  pokemon
  supporter
  item
  stadium
  tool
}

model Card {
  id         Int         @id @default(autoincrement())
  tcg        Tcg
  card_type  CardType
  name       String?
  edition    String?
  colors     CardColor[]
  status     Status      @default(active)
  created_at DateTime    @default(now())
  updated_at DateTime?   @updatedAt
  is_deleted Boolean     @default(false)
  order_items      OrderItem[]
  stock            CardStock?
  card_print_models CardPrintModel[]

  @@index([id])
  @@index([tcg])
  @@map("card")
}

model CardStock {
  id         Int       @id @default(autoincrement())
  card_id    Int       @unique
  quantity   Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  card       Card      @relation(fields: [card_id], references: [id])

  @@index([card_id])
  @@map("card_stock")
}

enum ProductionShipmentStatus {
  awaiting_print
  printing
  printed
}

model CardPrintModel {
  id          Int       @id @default(autoincrement())
  card_id     Int
  name        String
  file_name   String
  created_at  DateTime  @default(now())
  updated_at  DateTime? @updatedAt
  is_deleted  Boolean   @default(false)
  card        Card      @relation(fields: [card_id], references: [id])
  order_items OrderItem[]

  @@index([card_id])
  @@map("card_print_model")
}

model ProductionShipment {
  id             Int                      @id @default(autoincrement())
  display_number Int                      @unique
  status         ProductionShipmentStatus @default(awaiting_print)
  created_at     DateTime                 @default(now())
  updated_at     DateTime?                @updatedAt
  is_deleted     Boolean                  @default(false)
  order_items    OrderItem[]

  @@index([status])
  @@map("production_shipment")
}

enum OrderPipelineStatus {
  quote
  partial_payment
  paid
  awaiting_payment
  ready_for_delivery
  delivered
  withdrawn
}

enum DeliveryMethod {
  postal
  hand_delivery
}

enum OrderLineArtStatus {
  art_to_do
  art_ready
  confirmed
  printing
  printed
}

model Customer {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  city       String?
  state      String?
  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  is_deleted Boolean   @default(false)
  orders     Order[]
  gifts      CustomerGift[]

  @@index([name])
  @@map("customer")
}

model CustomerGift {
  id               Int         @id @default(autoincrement())
  customer_id      Int
  quantity_granted Int
  quantity_used    Int         @default(0)
  notes            String?
  created_at       DateTime    @default(now())
  updated_at       DateTime?   @updatedAt
  is_deleted       Boolean     @default(false)
  customer         Customer    @relation(fields: [customer_id], references: [id])
  order_items      OrderItem[]

  @@index([customer_id])
  @@map("customer_gift")
}

model Order {
  id              Int                 @id @default(autoincrement())
  customer_id     Int
  order_status    OrderPipelineStatus @default(quote)
  delivery_method DeliveryMethod?
  notes           String?
  order_date      DateTime            @db.Date
  created_at      DateTime            @default(now())
  updated_at      DateTime?           @updatedAt
  is_deleted      Boolean             @default(false)
  customer        Customer            @relation(fields: [customer_id], references: [id])
  items           OrderItem[]
  payments        OrderPayment[]

  @@index([customer_id])
  @@index([order_status])
  @@index([order_date])
  @@map("order")
}

model OrderItem {
  id                       Int                 @id @default(autoincrement())
  order_id                 Int
  card_id                  Int
  card_print_model_id      Int?
  customer_gift_id         Int?
  fulfill_from_stock       Boolean             @default(false)
  has_varnish              Boolean             @default(false)
  production_shipment_id   Int?
  quantity                 Int
  unit_price               Decimal             @db.Decimal(10, 2)
  art_status               OrderLineArtStatus  @default(art_to_do)
  created_at               DateTime            @default(now())
  updated_at               DateTime?           @updatedAt
  is_deleted               Boolean             @default(false)
  order                    Order               @relation(fields: [order_id], references: [id])
  card                     Card                @relation(fields: [card_id], references: [id])
  card_print_model         CardPrintModel?     @relation(fields: [card_print_model_id], references: [id])
  customer_gift            CustomerGift?       @relation(fields: [customer_gift_id], references: [id])
  production_shipment      ProductionShipment? @relation(fields: [production_shipment_id], references: [id])

  @@index([order_id])
  @@index([card_id])
  @@index([card_print_model_id])
  @@index([customer_gift_id])
  @@index([production_shipment_id])
  @@index([art_status])
  @@map("order_item")
}

model OrderPayment {
  id           Int       @id @default(autoincrement())
  order_id     Int
  amount       Decimal   @db.Decimal(10, 2)
  collected_at DateTime  @db.Date
  notes        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime? @updatedAt
  is_deleted   Boolean   @default(false)
  order        Order     @relation(fields: [order_id], references: [id])

  @@index([order_id])
  @@index([collected_at])
  @@map("order_payment")
}
