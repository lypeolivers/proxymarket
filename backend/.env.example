#APP
VERSION='1.0.0'
APP_NAME='ProxyMarket API'
# LOCAL | DEV | HMG | PROD
MODE='LOCAL'
PORT=3333
# Prefixo das rotas. Padrão /api.
BASE_URL=/api
PASSWORD_HASH_SALT_ROUNDS=10

#DATABASE
DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:5432/proxymarket'
DEFAULT_PRISMA_TRANSACTION_TIMEOUT=30000

#AUTH
AUTH_JWT_ACCESS_TOKEN_SECRET='change-me-access-secret-with-32-chars'
AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN='1h'
AUTH_JWT_REFRESH_TOKEN_SECRET='change-me-refresh-secret-with-32-chars'
AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN='7d'

# Origens permitidas pelo CORS (separadas por vírgula). Obrigatório em PROD/HMG.
# Em DEV/LOCAL, se vazio, aceita qualquer origem.
CORS_ALLOWED_ORIGINS=''

# URL pública do frontend — usada em links externos (e-mails futuros, CTAs).
APP_WEB_URL=http://localhost:5173

# Credenciais usadas pelo `yarn db:seed` para criar o admin inicial.
ADMIN_NAME='Administrador'
ADMIN_EMAIL='admin@proxymarket.local'
ADMIN_PASSWORD='changeMe123!'
